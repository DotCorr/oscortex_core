@@ -1207,6 +1219,13 @@ String _emitGlobal(DCGlobal global, {required String context}) {
   return buffer.toString();
 }
 
+/// `@llvm.compiler.used` so unused `@rodata` survives `-O2` GlobalDCE.
+String _emitCompilerUsed(List<DCGlobal> used) {
+  final body = used.map((g) => 'ptr @${g.linkName}').join(', ');
+  return '@llvm.compiler.used = appending global [${used.length} x ptr] '
+      '[$body], section "llvm.metadata"';
+}
