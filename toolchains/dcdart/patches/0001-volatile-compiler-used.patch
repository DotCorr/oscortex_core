+/// MMIO/side-effect pointer. dcc-lower emits volatile Load/Store operations
+/// for every `.value` access, so optimization cannot elide or reorder it.
+class Volatile<T> {
+  final u64 _address;
+  const Volatile.fromAddress(this._address);
+
+  T get value =>
+      throw UnimplementedError('dcc-lower substitutes volatile codegen');
+  set value(T v) =>
+      throw UnimplementedError('dcc-lower substitutes volatile codegen');
+}
